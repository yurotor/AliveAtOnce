# Neon Postgres connection string
DATABASE_URL=

# Vercel AI Gateway key — used by the data pipeline for Jev (typesafe-ai/jev) and Claude.
# Vercel dashboard → AI Gateway → API Keys. Not needed on Vercel itself (OIDC).
AI_GATEWAY_API_KEY=

# Optional: override the canonical URL (defaults to https://aliveatonce.app)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Direct alternatives to the gateway for the pipeline: Jev via TypeSafe, Claude via Anthropic.
# TYPESAFE_API_KEY=
# ANTHROPIC_API_KEY=
